	<queryString>
		<![CDATA[SELECT p.nome, b.idbam, s.setor, l.local,
     (
        select sum(sa.volumeml)
        from balanco_hidrico_saidas sa
        where  cast(sa.bam as text) = $P{pbam}
          and cast(sa.dataregistro as date) = cast($P{dt1} as date)
    ) as total_saidas
    ,
      (
        select sum(sa.volumeml)
        from balanco_hidrico_entradas sa
        where  cast(sa.bam as text) = $P{pbam}
          and cast(sa.dataregistro as date) = cast($P{dt1} as date)
    ) as total_entrada,
    (
    	 
 SELECT peso2
FROM prescricaocont where prescricaocont.bam = cast($P{pbam} as integer)
	 and cast(public.prescricaocont.data as date) = 	cast($P{dt1} as date) 
	 	  
	 	order by   idprescricaocontinuacao desc limit 1
    )


 FROM  pacientes p 
LEFT JOIN bam b on p.idpaciente = b.paciente_idpaciente
LEFT JOIN novointernado n on n.nbam = b.idbam
LEFT JOIN setorcenso s on s.idsetorcenso = n.setor_idsetorcenso
LEFT JOIN localcenso l on l.idsetorlocalcenso = n.local_idsetorlocalcenso
 where cast(b.idbam as Integer)=  cast($P{pbam} as Integer)]]>
	</queryString>
