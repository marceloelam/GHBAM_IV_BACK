	<parameter name="idbamLab" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    p.dt,
    p.hr,
    p.pedido,
    p.local,

    CASE
        WHEN LOWER(p.local) = 'laboratorio'
            THEN COALESCE(p.liberouexame::text, '')
        ELSE ''
    END AS liberouexame,

    CASE
        WHEN LOWER(p.local) = 'laboratorio'
            THEN COALESCE(p.liberoucoleta::text, '')
        ELSE ''
    END AS liberoucoleta,

    CASE
        WHEN LOWER(p.local) = 'medicamento'
            THEN COALESCE(m.enfermeiro, '')
        ELSE ''
    END AS enfermeiro,

    CASE
        WHEN LOWER(p.local) = 'medicamento'
            THEN COALESCE(m.observacao, '')
        ELSE ''
    END AS observacao,

    p.obs

FROM medicacao m
INNER JOIN pedidomedico2 p
    ON CAST(m.bam AS INTEGER) = CAST(p.bam AS INTEGER)

WHERE m.bam::text = $P{idbamLab}
  AND m.data::date = p.dt::date

GROUP BY
    p.dt,
    p.hr,
    p.pedido,
    p.local,
    p.liberouexame,
    p.liberoucoleta,
    m.enfermeiro,
    m.observacao,
    p.obs

ORDER BY
    p.dt DESC,
    p.hr;]]>
