	<queryString language="SQL">
		<![CDATA[select s.nome as nservidor, * from   pacientes p
inner join bam b on
p.idpaciente = b.paciente_idpaciente
inner join afaturar a on 
a.bam = b.idbam
inner join  registro r on 
r.idregistro = b.registro_idregistro
inner join servidor s on
s.cns = a.cnsdoprofissional

where a.cnsdoprofissional is not null
and a.bam = b.idbam  and b.unidade =  $P{ssigla} 
and b.idbam = cast($P{pbam} as integer) 
ORDER BY p.nome, a.cnsdoprofissional, a.procedimento, a.descricao]]>
	</queryString>
