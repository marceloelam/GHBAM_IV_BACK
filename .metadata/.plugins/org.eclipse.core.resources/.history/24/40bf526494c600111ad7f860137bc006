	<queryString language="SQL">
		<![CDATA[SELECT DISTINCT ON ( relato , cast(evolucaopaciente.data as date), idevolucao ) relato, cast(evolucaopaciente.data as date) ,idevolucao,*
FROM public.bam
	INNER JOIN public.pacientes ON 
	 public.bam.paciente_idpaciente = public.pacientes.idpaciente 
	INNER JOIN public.evolucaopaciente ON 
	 public.evolucaopaciente.nbam = public.bam.idbam 

	 
	WHERE 
	 cast(public.evolucaopaciente.nbam as text) = $P{pbam}  and public.bam.unidade =  $P{ssigla}
	 and cast(evolucaopaciente.data as date) between  cast($P{dt1} as date) and  cast($P{dt2} as date) 
