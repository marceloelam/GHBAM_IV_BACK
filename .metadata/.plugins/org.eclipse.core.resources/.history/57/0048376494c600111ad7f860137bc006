CREATE TABLE IF NOT EXISTS unidade_video_volume (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    sigla VARCHAR(15) NOT NULL,
    tv INTEGER NOT NULL,
    mudo BOOLEAN NOT NULL DEFAULT FALSE,
    volume INTEGER NOT NULL DEFAULT 80,
    CONSTRAINT uk_unidade_video_volume_sigla_tv UNIQUE (sigla, tv),
    CONSTRAINT ck_unidade_video_volume_tv CHECK (tv BETWEEN 1 AND 10),
    CONSTRAINT ck_unidade_video_volume_volume CHECK (volume BETWEEN 0 AND 100)
);
