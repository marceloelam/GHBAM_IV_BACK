	<queryString language="SQL">
		<![CDATA[SELECT assinatura.assinado_por AS assinatura_assinado_por,
assinatura.assinado_por_matricula AS assinatura_matricula,
to_char(assinatura.assinado_em, 'DD/MM/YYYY HH24:MI') AS assinatura_data_hora,
assinatura.conteudo_hash AS assinatura_hash,
assinatura.idassinatura AS assinatura_id,
*
FROM public.laudoautorizacao
	INNER JOIN public.bam ON 
	 public.bam.idbam = public.laudoautorizacao.bam 
	INNER JOIN public.pacientes ON 
	 public.bam.paciente_idpaciente = public.pacientes.idpaciente 
	INNER JOIN public.registro ON 
	 public.bam.registro_idregistro = public.registro.idregistro
	 	INNER JOIN public.avaliacao ON 
	 public.bam.avaliacao_idavaliacao = public.avaliacao.idavaliacao
	 LEFT JOIN LATERAL (
		SELECT ac.idassinatura, ac.assinado_por, ac.assinado_por_matricula, ac.assinado_em, ac.conteudo_hash
		FROM public.assinatura_clinica ac
		WHERE upper(ac.tipo_documento) = 'LAUDO_AUTORIZACAO'
		  AND ac.iddocumento = public.laudoautorizacao.idlaudo
		  AND upper(ac.status) = 'ASSINADO'
		ORDER BY ac.idassinatura DESC
		LIMIT 1
	 ) assinatura ON TRUE
	 WHERE public.laudoautorizacao.bam  =  cast($P{pbam} as integer)
	 and public.bam.unidade =  $P{ssigla}]]>
	</queryString>
