	<queryString language="SQL">
		<![CDATA[select distinct on (
    cast(visitantes.datavisita as date),
    s.setor,
    l.local,
    pacientes.nome,
    visitantes.nomevisitante
)
    visitantes.nomevisitante,
    cast(visitantes.datavisita as date) as datavisita,
    visitantes.endereco,
    visitantes.identidadevisitante,
    visitantes.cpfvisitante,
    visitantes.telefone,
    visitantes.obsvisitante,
    visitantes.fotovisitante,
    pacientes.nome,
    pacientes.idade,
    s.setor,
    l.local,
    visitantes.horavisitante
from pacientes
inner join bam on bam.paciente_idpaciente = pacientes.idpaciente
inner join visitantes on cast(bam.idbam as integer) = cast(visitantes.nbam as integer)
inner join novointernado on cast(bam.idbam as integer) = cast(novointernado.bam_idbam as integer)
inner join setorcenso s on novointernado.setor_idsetorcenso = s.idsetorcenso
left join localcenso l on novointernado.local_idsetorlocalcenso = l.idsetorlocalcenso
where 
  bam.unidade = $P{ssigla}
  and (
    $P{pbam} is null
    or trim($P{pbam}) = ''
    or cast(bam.idbam as text) = trim($P{pbam})
  )
  and cast(datavisita as date) between cast($P{dt1} as date) and cast($P{dt2} as date)
order by
    cast(visitantes.datavisita as date) desc,
    s.setor,
    l.local,
    pacientes.nome,
    visitantes.nomevisitante;]]>
	</queryString>
