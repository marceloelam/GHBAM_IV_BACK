CREATE TABLE unidade_video_canal (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    sigla VARCHAR(15) NOT NULL,
    nome VARCHAR(160) NOT NULL,
    descricao VARCHAR(160),
    logo TEXT,
    url TEXT NOT NULL,
    ordem INTEGER NOT NULL,
    CONSTRAINT uk_unidade_video_canal_sigla_url UNIQUE (sigla, url),
    CONSTRAINT ck_unidade_video_canal_ordem CHECK (ordem BETWEEN 1 AND 5)
);

CREATE INDEX idx_unidade_video_canal_sigla_ordem
    ON unidade_video_canal (sigla, ordem, id);

ALTER TABLE unidade_video_volume
    ADD COLUMN canal_id BIGINT;

ALTER TABLE unidade_video_volume
    ADD CONSTRAINT fk_unidade_video_volume_canal
    FOREIGN KEY (canal_id) REFERENCES unidade_video_canal (id)
    ON DELETE SET NULL;
