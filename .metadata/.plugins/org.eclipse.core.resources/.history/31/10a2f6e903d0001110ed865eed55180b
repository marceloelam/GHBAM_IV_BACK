ALTER TABLE notificacao_sinan
    ADD COLUMN IF NOT EXISTS periodicidade VARCHAR(20),
    ADD COLUMN IF NOT EXISTS prazo_notificacao TIMESTAMP,
    ADD COLUMN IF NOT EXISTS encaminhado_em TIMESTAMP,
    ADD COLUMN IF NOT EXISTS encaminhado_por VARCHAR(120),
    ADD COLUMN IF NOT EXISTS recebido_em TIMESTAMP,
    ADD COLUMN IF NOT EXISTS recebido_por VARCHAR(120),
    ADD COLUMN IF NOT EXISTS transmitido_em TIMESTAMP,
    ADD COLUMN IF NOT EXISTS transmitido_por VARCHAR(120),
    ADD COLUMN IF NOT EXISTS referencia_transmissao VARCHAR(160);

CREATE INDEX IF NOT EXISTS idx_notificacao_sinan_pendencias
    ON notificacao_sinan (unidade, prazo_notificacao)
    WHERE status IN ('PRONTO', 'ENCAMINHADO', 'RECEBIDO');

CREATE TABLE IF NOT EXISTS notificacao_sinan_historico (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    notificacao_id BIGINT NOT NULL,
    acao VARCHAR(30) NOT NULL,
    status_anterior VARCHAR(20),
    status_novo VARCHAR(20) NOT NULL,
    usuario VARCHAR(120),
    observacao VARCHAR(500),
    criado_em TIMESTAMP NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_sinan_historico_notificacao_data
    ON notificacao_sinan_historico (notificacao_id, criado_em);
