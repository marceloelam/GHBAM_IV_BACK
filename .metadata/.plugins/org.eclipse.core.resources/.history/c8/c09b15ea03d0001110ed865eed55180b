	<queryString language="SQL">
		<![CDATA[SELECT 
    CAST(bam.data AS date) AS data,
    registro.setor,
    COUNT(registro.setor) AS total
FROM bam
INNER JOIN registro 
    ON bam.registro_idregistro = registro.idregistro
WHERE CAST(bam.data AS date) BETWEEN CAST($P{datainicial} AS date)
                                AND CAST($P{datafinal} AS date)
  AND bam.unidade = $P{ssigla}
  AND registro.setor like concat('%',$P{setor},'%')
      
GROUP BY CAST(bam.data AS date), registro.setor
ORDER BY CAST(bam.data AS date) DESC;]]>
