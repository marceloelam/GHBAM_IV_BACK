	<queryString language="SQL">
		<![CDATA[SELECT bam.data,
	pacientes.bairro, pacientes.municipio,
	registro.setor, COUNT(registro.setor) AS TOTAL
FROM bam
	INNER JOIN pacientes ON 
	 bam.paciente_idpaciente = pacientes.idpaciente 
	INNER JOIN registro ON 
	 bam.registro_idregistro = registro.idregistro 
WHERE
cast(bam.data as date)  between  cast($P{datainicial} as date)  and cast($P{datafinal} as date)
 and registro.setor =   $P{setor} 
  and public.bam.unidade =  $P{ssigla} 
group by bam.data,	pacientes.bairro,	registro.setor, pacientes.municipio
ORDER BY bam.data ASC, pacientes.municipio ASC, pacientes.bairro ASC]]>
	</queryString>
