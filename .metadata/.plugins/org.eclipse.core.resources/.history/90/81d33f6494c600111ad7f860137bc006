CREATE TABLE IF NOT EXISTS unidade_video_canal (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    sigla VARCHAR(15) NOT NULL,
    nome VARCHAR(160) NOT NULL,
    descricao VARCHAR(160),
    logo TEXT,
    url TEXT NOT NULL,
    ordem INTEGER NOT NULL
);

ALTER TABLE unidade_video_canal
    ALTER COLUMN logo TYPE TEXT,
    ALTER COLUMN url TYPE TEXT;

DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1
        FROM pg_constraint
        WHERE conname = 'uk_unidade_video_canal_sigla_url'
    ) THEN
        ALTER TABLE unidade_video_canal
            ADD CONSTRAINT uk_unidade_video_canal_sigla_url UNIQUE (sigla, url);
    END IF;
END $$;

DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1
        FROM pg_constraint
        WHERE conname = 'ck_unidade_video_canal_ordem'
    ) THEN
        ALTER TABLE unidade_video_canal
            ADD CONSTRAINT ck_unidade_video_canal_ordem CHECK (ordem BETWEEN 1 AND 5);
    END IF;
END $$;

CREATE INDEX IF NOT EXISTS idx_unidade_video_canal_sigla_ordem
    ON unidade_video_canal (sigla, ordem, id);

ALTER TABLE unidade_video_volume
    ADD COLUMN IF NOT EXISTS canal_id BIGINT;

DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1
        FROM pg_constraint
        WHERE conname = 'fk_unidade_video_volume_canal'
    ) THEN
        ALTER TABLE unidade_video_volume
            ADD CONSTRAINT fk_unidade_video_volume_canal
            FOREIGN KEY (canal_id) REFERENCES unidade_video_canal (id)
            ON DELETE SET NULL;
    END IF;
END $$;
