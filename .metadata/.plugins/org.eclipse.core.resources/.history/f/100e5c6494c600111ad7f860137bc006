	so.agravonotificacao AS so_agravonotificacao,
	so.agravoespecificar AS so_agravoespecificar,
	so.sumarioadmissao AS so_sumarioadmissao,
	so.medicoassistente AS so_medicoassistente,
	so.crmassistente AS so_crmassistente,
	so.dataassinaturaassistente AS so_dataassinaturaassistente,
	so.revisor AS so_revisor,
	so.crmrevisor AS so_crmrevisor,
	so.dataassinaturarevisor AS so_dataassinaturarevisor
FROM public.bam
	INNER JOIN public.pacientes ON 
	 public.bam.paciente_idpaciente = public.pacientes.idpaciente 
	INNER JOIN public.resumodealta ON 
	 public.resumodealta.bam = CAST(public.bam.idbam AS text)
	LEFT JOIN LATERAL (
		SELECT a.idassinatura,
			a.assinado_por,
			a.assinado_por_matricula,
			a.assinado_em,
			a.conteudo_hash
		FROM public.assinatura_clinica a
		WHERE upper(a.tipo_documento) = 'RESUMO_ALTA'
			AND a.iddocumento = public.resumodealta.idResumoalta
			AND upper(a.status) = 'ASSINADO'
		ORDER BY a.idassinatura DESC
		LIMIT 1
	) assinatura ON TRUE
	LEFT JOIN public.sumarioobito so ON so.idresumoalta = public.resumodealta.idResumoalta
		AND so.unidade = public.bam.unidade
