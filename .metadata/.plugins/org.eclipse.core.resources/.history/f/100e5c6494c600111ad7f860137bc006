	CASE WHEN so.datainternacao ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}' THEN to_char(to_date(substr(so.datainternacao, 1, 10), 'YYYY-MM-DD'), 'DD-MM-YYYY') ELSE replace(so.datainternacao, '/', '-') END AS so_datainternacao,
	CASE WHEN so.datanascimento ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}' THEN to_char(to_date(substr(so.datanascimento, 1, 10), 'YYYY-MM-DD'), 'DD-MM-YYYY') ELSE replace(so.datanascimento, '/', '-') END AS so_datanascimento,
