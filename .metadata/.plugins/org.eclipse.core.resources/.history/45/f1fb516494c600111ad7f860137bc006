	<queryString language="SQL">
		<![CDATA[SELECT  p.*,	 	
	 	(
        select sum(sa.volumeml)
        from balanco_hidrico_saidas sa
        where cast(sa.bam as integer) = cast(s.bam as integer)
          and sa.tipo = 'URINA'
          and cast(sa.dataregistro as date )= cast($P{dt1} as date)
    ) as soma_urina
    ,
    (
        select sum(sa.volumeml)
        from balanco_hidrico_saidas sa
        where cast(sa.bam as integer) = cast(s.bam as integer)
          and cast(sa.dataregistro as date )= cast($P{dt1} as date)
          and cast(sa.bam as text) = $P{pbam}
    ) as soma_Total_saida
    ,(
        select sum(e.volumeml)
        from balanco_hidrico_entradas e
        where cast(e.bam as integer) = cast(s.bam as integer)
          and cast(e.dataregistro as date )= cast($P{dt1} as date)
          and cast(e.bam as text) = $P{pbam}
    ) as soma_Total_entrada
    
    from  balanco_hidrico_saidas s  
left join prescricaocont p 
    on cast(p.bam as integer) = cast(s.bam as integer)
where cast(s.bam as text) = $P{pbam}
  and cast(s.dataregistro as date) = cast($P{dt1} as date)
  order by p.idprescricaocontinuacao desc limit 1]]>
