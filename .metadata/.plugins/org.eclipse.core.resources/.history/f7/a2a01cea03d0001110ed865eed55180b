	<queryString language="SQL">
		<![CDATA[select distinct
    s.tipo,  
    p.peso2,  
    (
        select sum(sa.volumeml)
        from balanco_hidrico_saidas sa
        where cast(sa.bam as integer) = cast(s.bam as integer)
