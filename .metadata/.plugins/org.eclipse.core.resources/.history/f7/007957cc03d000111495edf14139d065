	<queryString language="SQL">
		<![CDATA[SELECT DISTINCT ON (p.nome, b.idbam, CAST(i.datainternacao AS date), i.local)
    p.nome, 
    b.idbam, 
    i.ndocumento, 
    i.procedencia, 
    i.medicodeualta, 
    i.datainternacao, 
    i.datasaida, 
    i.local,
    CAST(i.datasaida AS date) - CAST(i.datainternacao AS date) AS diasInternados
FROM pacientes p
JOIN internacao i ON p.prontuario = i.prontuario
JOIN bam b ON p.idpaciente = b.paciente_idpaciente and  cast(i.bam as integer) = b.idbam
WHERE b.unidade = $P{ssigla}
  AND CAST(i.datasaida AS date) BETWEEN CAST($P{datainicial} AS date) AND CAST($P{datafinal} AS date)
  AND i.datasaida IS NOT NULL
ORDER BY  i.local, p.nome, b.idbam,CAST(i.datainternacao AS date), i.datasaida desc]]>
	</queryString>
