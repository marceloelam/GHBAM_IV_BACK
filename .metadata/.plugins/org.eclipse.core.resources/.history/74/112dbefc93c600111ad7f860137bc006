  ADD COLUMN IF NOT EXISTS outros_antecedentes_gestacionais TEXT,
  ADD COLUMN IF NOT EXISTS intercorrencias_gestacao BOOLEAN,
  ADD COLUMN IF NOT EXISTS medicacoes_gestacao TEXT,

