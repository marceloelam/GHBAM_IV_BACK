	<queryString language="SQL">
		<![CDATA[select * from afaturar a,  pacientes p, bam b
where a.idpaciente =p.idpaciente 
and a.bam = b.idbam  and a.unidade =  $P{ssigla}
and   a.local like  concat($P{local},'%') 
and
case when   $P{gbairro}='MIGUEL PEREIRA' then p.municipio not like '%PATY%' else 
case when  $P{gbairro}='PATY DO ALFERES' then p.municipio like '%PATY%' else 
p.municipio like  concat($P{gbairro},'%') end end and	cast(a.data as date) between  cast($P{datainicial}  as date) and  cast($P{datafinal}  as date)  

group by  a.procedimento,  a.local, a.idafaturar , p.idpaciente	, b.idbam 
ORDER BY   p.municipio, a.local, a.procedimento,  cast(a.data as date)]]>
	</queryString>
