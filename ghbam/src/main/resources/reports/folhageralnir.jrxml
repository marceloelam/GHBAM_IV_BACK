	<queryString language="SQL">
		<![CDATA[SELECT * FROM pacientes, bam
WHERE pacientes.idpaciente = bam.paciente_idpaciente   
and bam.unidade =  $P{ssigla} and  prontuario =  $P{numerodoprontuario}
order by bam.idbam desc limit 1]]>
	</queryString>
