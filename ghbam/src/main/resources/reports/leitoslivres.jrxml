	<queryString language="SQL">
		<![CDATA[select * from localcenso l, setorcenso s
where l.setorcenso_idsetorcenso = s.idsetorcenso 
and l.unidade =  $P{ssigla}  and l.excluido = false
and idsetorlocalcenso not in  
(select nov.local_idsetorlocalcenso from novointernado nov where alta = false ) 
	  order by s.setor, l.local]]>
	</queryString>
