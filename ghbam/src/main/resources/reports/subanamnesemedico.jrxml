	<parameter name="idbamLab" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select a.*, t.parecer_especialista, t.destino, t.medicoecrm from avaliacao a inner join bam b on  
b.avaliacao_idavaliacao = a.idavaliacao
inner join pacientes p on
b.paciente_idpaciente = p.idpaciente
inner join tratamento t on
b.tratamento_idtratamento = t.idtratamento
where  cast(b.idbam as text) =  $P{idbamLab} order by b.idbam desc limit 1]]>
	</queryString>
