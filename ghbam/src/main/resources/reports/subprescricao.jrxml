					</reportElement>
					<textElement/>
					<textFieldExpression><![CDATA[($F{data} == null ? "" : ($F{data}.matches("^\\d{4}[-/]\\d{2}[-/]\\d{2}.*") ? $F{data}.substring(8,10) + "/" + $F{data}.substring(5,7) + "/" + $F{data}.substring(0,4) : $F{data})) + " " + ($F{hora} == null ? "" : String.valueOf($F{hora}).trim())]]></textFieldExpression>
