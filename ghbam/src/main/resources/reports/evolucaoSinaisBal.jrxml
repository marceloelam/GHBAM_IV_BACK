<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="evolucao" pageWidth="595" pageHeight="842" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isFloatColumnFooter="true" uuid="f90ae1c5-b6cd-4c8c-a958-50b845e718d3">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="itaguai_conn"/>
	<parameter name="pbam" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="hospital" class="java.lang.String"/>
	<parameter name="ssigla" class="java.lang.String"/>
	<parameter name="prefeitura" class="java.lang.String"/>
	<parameter name="complemento" class="java.lang.String"/>
	<parameter name="dt1" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT prescricaocont.data as pdata, prescricaocont.hora as phora, *
FROM public.bam
	INNER JOIN public.pacientes ON 
	 public.bam.paciente_idpaciente = public.pacientes.idpaciente 
	 INNER JOIN public.novointernado ON
	 public.bam.idbam = public.novointernado.nbam
	 INNER JOIN public.setorcenso ON
	 public.setorcenso.idsetorcenso = public.novointernado.setor_idsetorcenso
	  INNER JOIN public.localcenso ON
	 public.localcenso.idsetorlocalcenso = public.novointernado.local_idsetorlocalcenso
	 INNER JOIN public.prescricaocont ON
	 public.prescricaocont.bam = public.novointernado.nbam and  
	 	public.prescricaocont.bam = cast($P{pbam} as integer)
	 and cast(public.prescricaocont.data as date) = 	cast($P{dt1} as date) 
	 	  
	 	order by cast(public.prescricaocont.data as date) desc, cast(public.prescricaocont.hora as time) desc]]>
	</queryString>
