	<queryString language="SQL">
		<![CDATA[select s.nome, s.cargo, s.corem, a.* from avaliacao a, bam b, servidor s  
where  b.avaliacao_idavaliacao = a.idavaliacao
 and s.idservidor = b.servidor_idservidor  
and   cast(b.idbam as text) =  $P{idbamLab}]]>
	</queryString>
