	<title>
		<band height="88" splitType="Stretch">
			<staticText>
				<reportElement x="70" y="56" width="409" height="30" uuid="6bbce828-6635-4596-91f3-b91edacee8ef"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[TERMO DE RESPONSABILIDADE PARA INTERNAÇÃO HOSPITALAR E PROCEDIMENTOS MÉDICO-CIRÚRGICOS]]></text>
			</staticText>
			<textField>
				<reportElement x="161" y="38" width="319" height="20" uuid="5d9eda09-2aea-4aa8-87ab-23f0eae3688a"/>
				<textElement>
					<font size="10" isBold="true"/>
				</textElement>
