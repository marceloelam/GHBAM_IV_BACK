	<queryString language="SQL">
		<![CDATA[SELECT *
FROM pacientes, bam
	WHERE
	bam.paciente_idpaciente = pacientes.idpaciente
	 and bam.unidade =  $P{ssigla} 
	AND
	cast(bam.idbam as text) =  $P{pbam}]]>
	</queryString>
