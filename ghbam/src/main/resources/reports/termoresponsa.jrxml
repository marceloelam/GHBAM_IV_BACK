			<image hAlign="Center" vAlign="Middle" onErrorType="Blank">
				<reportElement stretchType="RelativeToTallestObject" x="1" y="3" width="139" height="53" uuid="c000f5c8-a0a9-4e27-9184-540960fadea8"/>
