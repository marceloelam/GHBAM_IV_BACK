	<parameter name="logo" class="java.lang.String"/>
	<parameter name="hospital" class="java.lang.String"/>
	<parameter name="ssigla" class="java.lang.String"/>
	<parameter name="prefeitura" class="java.lang.String"/>
	<parameter name="complemento" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT DISTINCT ON (p.nome)
       p.nome,
       p.*,
       i.*,
       b.*,
       CURRENT_DATE - i.datainternacao::date AS diasInternados,
       (
           SELECT s.setor || ' - ' || l.local
           FROM novointernado n
           INNER JOIN setorcenso s ON s.idsetorcenso = n.setor_idsetorcenso
           INNER JOIN localcenso l ON l.idsetorlocalcenso = n.local_idsetorlocalcenso
           WHERE CAST(n.nbam AS text) = CAST(i.bam AS text)
             AND n.pacientes_idpaciente = p.idpaciente
             AND n.alta = FALSE
           LIMIT 1
       ) AS setor
FROM pacientes p,
     internacao i,
     bam b
WHERE p.prontuario = i.prontuario
  AND b.paciente_idpaciente = p.idpaciente
  AND  i.unidade = $P{ssigla}  
  AND i.datasaida IS NULL
  AND i.datainternacao >= CURRENT_DATE - INTERVAL '1 year'
ORDER BY
      p.nome,
      i.local,
      i.datainternacao DESC;]]>
	</queryString>
