	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="conn"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="248"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="745"/>
	<parameter name="pbam" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="hospital" class="java.lang.String"/>
	<parameter name="ssigla" class="java.lang.String"/>
	<parameter name="prefeitura" class="java.lang.String"/>
	<parameter name="complemento" class="java.lang.String"/>
	<parameter name="dt1" class="java.lang.String"/>
	<parameter name="dt2" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT distinct on (medicacao.observacao)medicacao.observacao, pacientes.idpaciente,
	pacientes.bairro,
	pacientes.cep,
	pacientes.cns,
	pacientes.cpf,
	pacientes.data,
	pacientes.ecivil,
	pacientes.endereco,
	pacientes.estado,
	pacientes.etnia,
	pacientes.hora,
	pacientes.idade,
	pacientes.latitude,
	pacientes.longitude,
	pacientes.mae,
	pacientes.municipio,
	pacientes.nascimento,
	pacientes.naturalidade,
	pacientes.nome,
	pacientes.numero,
	pacientes.pai,
	pacientes.profissao,
	pacientes.prontuario,
	pacientes.rg,
	pacientes.sangue,
	pacientes.sexo,
	pacientes.telefone,
	medicacao.hora,
	medicacao.enfermeiro,
	medicacao.data,
	medicacao.bam,
	pedidomedico.pedido,
	pedidomedico.medico,
	pedidomedico.crm,
	pedidomedico.setor
FROM bam
	INNER JOIN medicacao ON 
	 medicacao.bam = bam.idbam 
	INNER JOIN pacientes ON 
	 bam.paciente_idpaciente = pacientes.idpaciente 
	INNER JOIN pedidomedico ON 
	 pedidomedico.bam = bam.idbam 
WHERE 
	 bam.idbam = cast($P{pbam} as integer)  and bam.unidade =  $P{ssigla} 
	  and cast(medicacao.data as date) between  cast($P{dt1} as date) and  cast($P{dt2} as date)]]>
	</queryString>
