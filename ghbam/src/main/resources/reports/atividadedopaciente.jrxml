	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="teste"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="194"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="798"/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="hospital" class="java.lang.String"/>
	<parameter name="ssigla" class="java.lang.String"/>
	<parameter name="prefeitura" class="java.lang.String"/>
	<parameter name="complemento" class="java.lang.String"/>
	<parameter name="dt1" class="java.lang.String"/>
	<parameter name="dt2" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select * from pacientes p, bam b, laudoautorizacao l
where  l.bam = b.idbam  and b.paciente_idpaciente = p.idpaciente and b.unidade =  $P{ssigla} 
and cast(l.dataautorizacao as date) between cast( $P{dt1}  as date) and cast( $P{dt2} as date) 
group by  l.bam, p.idpaciente	, b.idbam,  l.idlaudo
ORDER BY  p.nome, l.bam, cast(l.dataautorizacao as date) desc]]>
	</queryString>
