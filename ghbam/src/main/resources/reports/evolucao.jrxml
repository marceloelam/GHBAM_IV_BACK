						<font size="5"/>
					</textElement>
					<textFieldExpression><![CDATA[$F{assinatura_id} == null ? "Documento ainda sem assinatura clinica localizada no " + $P{NOME_SISTEMA} + "." : "Documento: EVOLUCAO_MEDICA #" + $F{idevolucao} + " | Hash SHA-256: " + ($F{assinatura_hash} == null ? "" : $F{assinatura_hash})]]></textFieldExpression>
				</textField>
			</frame>
		</band>
	</detail>
</jasperReport>
