<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="evolucao" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f90ae1c5-b6cd-4c8c-a958-50b845e718d3">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="teste"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="203"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="786"/>
	<parameter name="pbam" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="hospital" class="java.lang.String"/>
	<parameter name="ssigla" class="java.lang.String"/>
	<parameter name="prefeitura" class="java.lang.String"/>
	<parameter name="complemento" class="java.lang.String"/>
	<parameter name="dt1" class="java.lang.String"/>
	<parameter name="dt2" class="java.lang.String"/>
	<parameter name="NOME_SISTEMA" class="java.lang.String"><defaultValueExpression><![CDATA["GHBAM"]]></defaultValueExpression></parameter>
	<queryString language="SQL">
		<![CDATA[SELECT DISTINCT ON ( relato , cast(evolucaopaciente.data as date), idevolucao, qtde )
relato,
cast(evolucaopaciente.data as date) as dt11,
idevolucao,
qtde,
assinatura.assinado_por AS assinatura_assinado_por,
assinatura.assinado_por_matricula AS assinatura_matricula,
to_char(assinatura.assinado_em, 'DD/MM/YYYY HH24:MI') AS assinatura_data_hora,
assinatura.conteudo_hash AS assinatura_hash,
assinatura.idassinatura AS assinatura_id,
*
FROM public.bam
	INNER JOIN public.pacientes ON 
	 public.bam.paciente_idpaciente = public.pacientes.idpaciente 
	INNER JOIN public.evolucaopaciente ON 
	 public.evolucaopaciente.nbam = public.bam.idbam 
	 INNER JOIN public.novointernado ON
	 public.bam.idbam = public.novointernado.nbam
	 INNER JOIN public.setorcenso ON
	 public.setorcenso.idsetorcenso = public.novointernado.setor_idsetorcenso
	  INNER JOIN public.localcenso ON
	 public.localcenso.idsetorlocalcenso = public.novointernado.local_idsetorlocalcenso
	 LEFT JOIN LATERAL (
		SELECT ac.idassinatura, ac.assinado_por, ac.assinado_por_matricula, ac.assinado_em, ac.conteudo_hash
		FROM public.assinatura_clinica ac
		WHERE upper(ac.tipo_documento) = 'EVOLUCAO_MEDICA'
		  AND ac.iddocumento = public.evolucaopaciente.idevolucao
		  AND upper(ac.status) = 'ASSINADO'
		ORDER BY ac.idassinatura DESC
		LIMIT 1
	 ) assinatura ON TRUE
	 
	WHERE 
	 cast(public.evolucaopaciente.nbam as text) = $P{pbam}  and public.bam.unidade =  $P{ssigla}
	
	 order by  cast(evolucaopaciente.data as date) desc, idevolucao, qtde]]>
	</queryString>
