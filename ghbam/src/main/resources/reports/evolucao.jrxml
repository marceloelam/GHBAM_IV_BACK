					<textElement verticalAlignment="Middle">
						<font size="6"/>
					</textElement>
					<textFieldExpression><![CDATA[$F{assinatura_id} == null ? "ASSINATURA CLINICA PENDENTE - Documento: EVOLUCAO_MEDICA #" + $F{idevolucao} + " | Profissional informado: " + ($F{medico} == null ? "" : $F{medico}) + " | CRM: " + ($F{crm} == null ? "" : $F{crm}) : "Assinado por: " + ($F{assinatura_assinado_por} == null ? "" : $F{assinatura_assinado_por}) + " | Matricula: " + ($F{assinatura_matricula} == null ? "nao informada" : $F{assinatura_matricula}) + " | Data/hora: " + ($F{assinatura_data_hora} == null ? "" : $F{assinatura_data_hora})]]></textFieldExpression>
