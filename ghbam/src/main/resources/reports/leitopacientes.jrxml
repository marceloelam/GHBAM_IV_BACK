	<style name="censoZebra">
		<conditionalStyle>
			<conditionExpression><![CDATA[(($F{setor}.equals("ENFERMARIA 107") || $F{setor}.equals("TRAUMA") ||  $F{setor}.equals("ESTABILIZAÇÃO")) &&   $F{diasinternados}<=1)]]></conditionExpression>
			<style mode="Opaque" backcolor="#54FF60"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[(($F{setor}.equals("ENFERMARIA 107") || $F{setor}.equals("TRAUMA") ||  $F{setor}.equals("ESTABILIZAÇÃO")) &&   ($F{diasinternados}>1 &&  $F{diasinternados}<=2))]]></conditionExpression>
			<style mode="Opaque" backcolor="rgba(255, 252, 74, 0.61960787)"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[( ($F{setor}.equals("ENFERMARIA 107") || $F{setor}.equals("TRAUMA") ||  $F{setor}.equals("ESTABILIZAÇÃO")) &&   $F{diasinternados}>2)]]></conditionExpression>
			<style mode="Opaque" backcolor="rgba(255, 175, 171, 0.4117647)"/>
