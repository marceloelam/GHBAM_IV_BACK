	<parameter name="logo" class="java.lang.String"/>
	<parameter name="hospital" class="java.lang.String"/>
	<parameter name="ssigla" class="java.lang.String"/>
	<parameter name="prefeitura" class="java.lang.String"/>
	<parameter name="complemento" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select b.hora as horbam, b.data as dtbam, *, cast(CURRENT_DATE as date ) - cast(n.diainternacao as date) as diasInternados 
from pacientes p, bam b, novointernado n, localcenso l, setorcenso s
where b.paciente_idpaciente = p.idpaciente
and b.idbam = n.bam_idbam
and n.setor_idsetorcenso = s.idsetorcenso
and n.local_idsetorlocalcenso = l.idsetorlocalcenso
and n.alta = false
and b.unidade =  $P{ssigla}  and l.excluido = false
and l.idsetorlocalcenso  in 
(select nov.local_idsetorlocalcenso from novointernado nov  where nov.alta = false) 
order by s.setor, l.local, p.nome]]>
	</queryString>
