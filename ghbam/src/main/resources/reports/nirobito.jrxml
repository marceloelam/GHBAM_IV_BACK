	<parameter name="datainicial" class="java.lang.String"/>
	<parameter name="datafinal" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="hospital" class="java.lang.String"/>
	<parameter name="ssigla" class="java.lang.String"/>
	<parameter name="prefeitura" class="java.lang.String"/>
	<parameter name="complemento" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT distinct on(p.nome) p.nome, *, cast(I.datasaida as date ) - cast(i.datainternacao as date) as diasInternados
FROM  pacientes p, internacao i, bam b
	WHERE
	p.prontuario = i.prontuario 
	and b.paciente_idpaciente = p.idpaciente and b.unidade =  $P{ssigla} 
and  cast(i.motivodaalta as text)  like 'OBIT%'
	and cast(i.datasaida as date) between  cast($P{datainicial} as date ) and  cast($P{datafinal}  as date )
 	and cast(datasaida as date) is not null 
	order by  p.nome asc, i.motivodaalta asc, i.datasaida asc]]>
	</queryString>
