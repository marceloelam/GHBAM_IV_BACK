	<parameter name="prefeitura" class="java.lang.String"/>
	<parameter name="complemento" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
(select count(*) from assinatura_clinica ac where ac.idbam = b.idbam and upper(ac.status) = 'ASSINADO') as assinaturas_clinicas_total,
(select count(*) from assinatura_clinica ac where ac.idbam = b.idbam and upper(ac.status) = 'ADENDO') as adendos_clinicos_total,
* FROM pacientes p, internacao i , bam b
WHERE b.idbam = cast(i.bam as integer) and b.paciente_idpaciente = p.idpaciente
 and b.unidade =  $P{ssigla} 
 and i.prontuario=  $P{numerodoprontuario}]]>
	</queryString>
