	<parameter name="prefeitura" class="java.lang.String"/>
	<parameter name="complemento" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select * from (select  distinct on(cast(i.bam as integer)) cast(i.bam as integer), * from pacientes p, internacao i, bam  b
where cast( i.datasaida as date)  between  cast($P{datainicial} as date ) and  cast($P{datafinal}  as date )
and p.prontuario =i.prontuario and b.paciente_idpaciente = p.idpaciente  and b.unidade =  $P{ssigla} 
and cast(datasaida as date) is not null ) t1
order by datainternacao asc]]>
	</queryString>
