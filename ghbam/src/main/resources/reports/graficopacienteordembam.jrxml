	<queryString language="SQL">
		<![CDATA[SELECT bam.data, bam.hora, bam.idbam, pacientes.nome,  pacientes.mae,pacientes.idade, pacientes.municipio, 
  servidor.nome  as servid   FROM pacientes, bam, servidor
   WHERE bam.paciente_idPaciente=pacientes.idPaciente  and  bam.servidor_idServidor=servidor.idServidor
  and bam.unidade =  $P{ssigla}    and cast(bam.data as date)  between  cast($P{datainicial} as date)  and cast($P{datafinal} as date)
   order by  bam.idbam]]>
	</queryString>
