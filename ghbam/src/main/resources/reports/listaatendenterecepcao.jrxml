	<queryString language="SQL">
		<![CDATA[SELECT  bam.data, bam.hora, bam.idBam, bam.natendente, pacientes.nome,  pacientes.mae,pacientes.idade, pacientes.municipio, 
  servidor.nome  as servid   FROM pacientes, bam, servidor
   WHERE bam.paciente_idPaciente=pacientes.idpaciente  and  bam.servidor_idServidor=servidor.idServidor
   and bam.unidade =  $P{ssigla} 
   and cast(bam.data as date) between  cast($P{datainicial} as date)  and  cast($P{datafinal} as date)
   order by  bam.data   desc, bam.hora, bam.idbam, bam.natendente]]>
	</queryString>
