	<parameter name="datainicial" class="java.lang.String"/>
	<parameter name="datafinal" class="java.lang.String"/>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="hospital" class="java.lang.String"/>
	<parameter name="ssigla" class="java.lang.String"/>
	<parameter name="prefeitura" class="java.lang.String"/>
	<parameter name="complemento" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT *, cast(CURRENT_DATE as date ) - cast(i.datainternacao as date) as diasInternados, (select (s.setor || ' - ' || l.local )  from novointernado n, localcenso l, setorcenso s 
 where cast(n.nbam as text)= cast(i.bam as text) and  n.setor_idsetorcenso = s.idsetorcenso 
 and n.local_idsetorlocalcenso= l.idsetorlocalcenso and n.alta = false  and  n.pacientes_idpaciente = p.idpaciente  ) as setor
FROM  pacientes p, internacao i, bam b
	WHERE
	p.prontuario = i.prontuario 
	and b.paciente_idpaciente = p.idpaciente and b.unidade =  $P{ssigla} 
	and cast(i.datainternacao as date) between  cast($P{datainicial} as date ) and  cast($P{datafinal}  as date )
	order by i.local asc, i.datainternacao asc, p.nome asc]]>
	</queryString>
