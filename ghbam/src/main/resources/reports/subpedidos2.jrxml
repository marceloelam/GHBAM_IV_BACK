	<parameter name="idBamPed" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select p.*,
assinatura.assinado_por AS assinatura_assinado_por,
assinatura.assinado_por_matricula AS assinatura_matricula,
to_char(assinatura.assinado_em, 'DD/MM/YYYY HH24:MI') AS assinatura_data_hora,
assinatura.conteudo_hash AS assinatura_hash,
assinatura.idassinatura AS assinatura_id
from pedidomedico2 p
LEFT JOIN LATERAL (
	SELECT ac.idassinatura, ac.assinado_por, ac.assinado_por_matricula, ac.assinado_em, ac.conteudo_hash
	FROM public.assinatura_clinica ac
	WHERE upper(ac.tipo_documento) = 'PEDIDO_MEDICO'
	  AND ac.iddocumento = p.idpedidomedico
	  AND upper(ac.status) = 'ASSINADO'
	ORDER BY ac.idassinatura DESC
	LIMIT 1
) assinatura ON TRUE
where p.bam =  cast($P{idBamPed} as integer)  order by  p.local, cast(p.dt as date)]]>
	</queryString>
