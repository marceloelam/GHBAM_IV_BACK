				</reportElement>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="Td" x="0" y="0" width="62" height="13" uuid="aea78f6f-ef1b-4cf6-95ee-de3b7a0ea628">
					</reportElement>
					<textElement/>
					<textFieldExpression><![CDATA[($F{dt} == null ? "" : ($F{dt}.matches("^\\d{4}[-/]\\d{2}[-/]\\d{2}.*") ? $F{dt}.substring(8,10) + "/" + $F{dt}.substring(5,7) + "/" + $F{dt}.substring(0,4) : $F{dt})) + "\n" + ($F{hr} == null ? "" : String.valueOf($F{hr}).trim())]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="Td" x="62" y="0" width="70" height="13" uuid="b893cbcd-e113-451d-915b-c48cc8e468bf">
					</reportElement>
					<textElement/>
					<textFieldExpression><![CDATA[("NENFERMAGEM".equals($F{local}) ? "ENFERMAGEM" : ($F{local} == null ? "" : String.valueOf($F{local}).trim()))]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="Td" x="132" y="0" width="180" height="13" uuid="f7b47085-ff01-47da-90ca-8f4501acf408">
					</reportElement>
					<textElement/>
					<textFieldExpression><![CDATA[($F{pedido} == null ? "" : $F{pedido}.replace("** PROCEDIMENTOS SELECIONADOS** <br /><br />* <b>0301100012 - ADMINISTRACAO DE MEDICAÇÃO</b><br /><br /> ** PEDIDO ** <br /><br />", "").replaceAll("(?i)<br\\s*/?>", "\n").replaceAll("<[^>]+>", "").replace("&nbsp;", " ").replaceAll("\n{3,}", "\n\n").trim()) + (Boolean.TRUE.equals($F{emergencia}) ? " (EMERGÊNCIA)" : "")]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="Td" x="312" y="0" width="128" height="13" uuid="52dc1141-33a2-453f-9f0d-cb8534a9a2f2">
					</reportElement>
					<textElement/>
					<textFieldExpression><![CDATA[($F{medico} == null ? "" : String.valueOf($F{medico}).trim()) + ($F{crm} == null || $F{crm}.trim().isEmpty() ? "" : " — " + $F{crm})]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="Td" x="440" y="0" width="115" height="13" uuid="74cf447b-3653-473b-b090-05d3a6ad396c">
					</reportElement>
					<textElement/>
					<textFieldExpression><![CDATA[($F{obs} == null ? "" : String.valueOf($F{obs}).trim())]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="Assin" positionType="Float" x="62" y="14" width="493" height="9" uuid="a7da46fb-4b4e-439a-9c5e-f16c717a20da">
					<printWhenExpression><![CDATA[$F{assinatura_id} != null]]></printWhenExpression>
					</reportElement>
					<textElement/>
					<textFieldExpression><![CDATA["Assinado eletronicamente por " + ($F{assinatura_assinado_por} == null ? "" : $F{assinatura_assinado_por}) + " | Matrícula: " + ($F{assinatura_matricula} == null ? "não informada" : $F{assinatura_matricula}) + " | " + ($F{assinatura_data_hora} == null ? "" : $F{assinatura_data_hora}) + " | SHA-256: " + ($F{assinatura_hash} == null ? "" : $F{assinatura_hash})]]></textFieldExpression>
				</textField>
