	<title>
		<band height="19" splitType="Prevent">
				<staticText>
					<reportElement style="Secao" x="0" y="0" width="555" height="15" uuid="1c996172-02ba-4159-af25-0645d5449a9c"/>
					<textElement/>
					<text><![CDATA[PEDIDOS MÉDICOS (EXCETO LABORATÓRIO)]]></text>
				</staticText>
		</band>
	</title>
	<detail>
		<band height="38" splitType="Stretch">
			<frame>
				<reportElement style="Linha" x="0" y="0" width="555" height="38" uuid="42eb931e-033b-4025-a18d-3406c52eedd6">
				</reportElement>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="ValorForte" x="3" y="3" width="330" height="11" uuid="9cf9c379-ab21-4dac-a73e-6d1dd27da16e">
					</reportElement>
					<textElement/>
					<textFieldExpression><![CDATA[($F{dt} == null ? "" : ($F{dt}.matches("^\\d{4}[-/]\\d{2}[-/]\\d{2}.*") ? $F{dt}.substring(8,10) + "/" + $F{dt}.substring(5,7) + "/" + $F{dt}.substring(0,4) : $F{dt})) + " " + ($F{hr} == null ? "" : String.valueOf($F{hr}).trim()) + "   •   " + ("NENFERMAGEM".equals($F{local}) ? "ENFERMAGEM" : ($F{local} == null ? "" : String.valueOf($F{local}).trim())) + ($F{setor} == null || $F{setor}.trim().isEmpty() ? "" : "   •   Setor: " + $F{setor}) + (Boolean.TRUE.equals($F{emergencia}) ? "   •   EMERGÊNCIA" : "")]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="Td" x="335" y="1" width="217" height="11" uuid="3568637a-e64e-40d5-a514-f560e8bd1c47">
					</reportElement>
					<textElement textAlignment="Right"/>
					<textFieldExpression><![CDATA["Dr(a). " + ($F{medico} == null ? "" : String.valueOf($F{medico}).trim()) + ($F{crm} == null || $F{crm}.trim().isEmpty() ? "" : " — CRM " + $F{crm})]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="Td" positionType="Float" x="3" y="15" width="549" height="11" uuid="55fd60a1-e15d-491e-a91c-f3e1af73f942">
					</reportElement>
					<textElement/>
					<textFieldExpression><![CDATA[($F{pedido} == null ? "" : $F{pedido}.replace("** PROCEDIMENTOS SELECIONADOS** <br /><br />* <b>0301100012 - ADMINISTRACAO DE MEDICAÇÃO</b><br /><br /> ** PEDIDO ** <br /><br />", "").replaceAll("(?i)<br\\s*/?>", "\n").replaceAll("<[^>]+>", "").replace("&nbsp;", " ").replaceAll("\n{3,}", "\n\n").trim())]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="Assin" positionType="Float" x="3" y="27" width="549" height="9" uuid="c24acde5-ce0e-41fe-948d-77b89d701c2d">
					<printWhenExpression><![CDATA[$F{assinatura_id} != null]]></printWhenExpression>
					</reportElement>
					<textElement/>
					<textFieldExpression><![CDATA["Assinado eletronicamente por " + ($F{assinatura_assinado_por} == null ? "" : $F{assinatura_assinado_por}) + " | Matrícula: " + ($F{assinatura_matricula} == null ? "não informada" : $F{assinatura_matricula}) + " | " + ($F{assinatura_data_hora} == null ? "" : $F{assinatura_data_hora}) + " | SHA-256: " + ($F{assinatura_hash} == null ? "" : $F{assinatura_hash})]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement style="Pendente" positionType="Float" x="3" y="27" width="549" height="9" uuid="1e9863fb-848f-4397-a340-eae7800cf6a8">
					<printWhenExpression><![CDATA[$F{assinatura_id} == null]]></printWhenExpression>
					</reportElement>
					<textElement/>
					<textFieldExpression><![CDATA["Assinatura clínica pendente — pedido médico nº " + $F{idpedidomedico}]]></textFieldExpression>
				</textField>
			</frame>
		</band>
	</detail>
