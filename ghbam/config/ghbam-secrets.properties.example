# Copie para config/ghbam-secrets.properties e preencha os valores reais.
# O arquivo real e ignorado pelo Git e nunca deve ser incluido no JAR.

DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=

LDAP_SERVER_URI=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=
LDAP_ADMIN_USER=
LDAP_ADMIN_PASSWORD=
LDAP_DOMAIN=

# Web Push: gere uma vez e preserve o mesmo par em todos os deploys.
# Trocar estas chaves invalida inscricoes de push que ja estao pareadas.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@exemplo.com

# Opcionais
ADMIN_RECOVERY_MATRICULA=
ADMIN_RECOVERY_PASSWORD=
REPORTS_DIR=src/main/resources/reports
HF_API_TOKEN=
HF_MODEL=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_GENAI_API_KEY=
CLAUD_RAG_API_KEY=
CLAUD_RAG_MODEL=
ENABLE_SET_AUTOCOMMIT_LOG=false

# Migrations de banco (defaults seguros da aplicacao)
GHBAM_FLYWAY_MIGRATE_AT_START=true
HIBERNATE_SCHEMA_GENERATION=validate
GHBAM_CLINICAL_SCHEMA_INITIALIZER_ENABLED=false

# Reconhecimento facial para reset de senha.
# Instale o servico facial onde preferir e aponte esta URL para ele.
# Exemplos:
# - Desenvolvimento na mesma maquina: http://127.0.0.1:8000/api/v1/verification/verify
# - Servidor interno/VPS: http://IP_OU_HOST_DO_SERVICO:8000/api/v1/verification/verify
GHBAM_FACE_VERIFICATION_URL=
GHBAM_FACE_API_KEY=
GHBAM_FACE_SIMILARITY_THRESHOLD=0.85
GHBAM_FACE_TIMEOUT_SECONDS=20
# Identificacao 1:N (/biofoto/webcam): servico Recognition do CompreFace (chave diferente da verificacao)
GHBAM_FACE_RECOGNITION_URL=
GHBAM_FACE_RECOGNITION_API_KEY=
GHBAM_FACE_RECOGNITION_SIMILARITY_THRESHOLD=0.9

# Identidade do sistema (opcional; sobrepoe application.properties)
#GHBAM_SISTEMA_NOME=GHBAM
#GHBAM_SISTEMA_NOME_COMPLETO=GHBAM IV
#GHBAM_SISTEMA_DESCRICAO=Gestão Hospitalar de Boletim de Atendimento Médico

# MinIO/S3: arquivos (GED, farmacia, laboratorio) fora do banco. false = tudo no banco.
# Use uma access key propria do backend, restrita ao bucket (nao o root do MinIO).
GHBAM_S3_HABILITADO=false
GHBAM_S3_ENDPOINT=http://127.0.0.1:9000
GHBAM_S3_BUCKET=ghbam-documentos
GHBAM_S3_ACCESS_KEY=
GHBAM_S3_SECRET_KEY=
